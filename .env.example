# ────────────────────────────────────────────────────────────
# Alizson Marketplace — Environment Variables
# ────────────────────────────────────────────────────────────
#
# SETUP INSTRUCTIONS:
# 1. Go to https://supabase.com → New Project → copy URL & anon key below
# 2. Go to https://paystack.com → Settings → API Keys → copy your public key
# 3. Run the SQL in supabase_schema.sql in your Supabase SQL Editor
# 4. Restart the dev server: npm run dev
# ────────────────────────────────────────────────────────────

# Supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE

# Paystack
# Test key starts with pk_test_, live key starts with pk_live_
VITE_PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PAYSTACK_PUBLIC_KEY_HERE
