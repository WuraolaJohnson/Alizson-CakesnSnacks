# ────────────────────────────────────────────────────────────
# Alizson Marketplace — Environment Variables
# ────────────────────────────────────────────────────────────
#
# SETUP INSTRUCTIONS:
# 1. https://console.firebase.google.com → Add project → Add a Web app →
#    copy the firebaseConfig values below
# 2. Enable Authentication → Email/Password and Google; create a Firestore
#    database; add your site's domain under Authentication → Settings →
#    Authorized domains
# 3. Deploy rules and the payment function (Blaze plan needed for functions):
#      firebase deploy --only firestore,functions
# 4. Go to https://paystack.com → Settings → API Keys → copy your public key
# 5. Restart the dev server: npm run dev
# ────────────────────────────────────────────────────────────

# Firebase
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Paystack
# Test key starts with pk_test_, live key starts with pk_live_
VITE_PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PAYSTACK_PUBLIC_KEY_HERE
